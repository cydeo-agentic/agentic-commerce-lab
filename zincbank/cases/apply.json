  {
    "id": "ZB-APPLY-13",
    "area": "apply",
    "title": "A full application with savings is approved and opens the dashboard",
    "given": [
      "A visitor who is NOT signed in (no fixture needed)",
      "A brand-new email nobody has registered: call the helper uniqueEmail('apply') imported from '../fixtures'. Do NOT use newCustomer here: it registers its email, and the application would then be refused"
    ],
    "steps": [
      "Open /apply",
      "Check apply-account-savings-toggle",
      "Click apply-next (moves to About you)",
      "Type Nora into apply-firstname-input",
      "Type Quill into apply-lastname-input",
      "Type the unique applicant email into apply-email-input",
      "Click apply-next",
      "Wait until apply-step-2 is visible",
      "Type 123456789 into apply-ssn-input",
      "Select the option with value employed in apply-employment-select",
      "Click apply-next",
      "Wait until apply-step-3 is visible",
      "Type 12 Elm Street into apply-addressline-input",
      "Type Springfield into apply-city-input",
      "Select the option with value MA in apply-state-select",
      "Type 20191 into apply-zip-input",
      "Click apply-next",
      "Type Passw0rd!zb into apply-password-input",
      "Type Passw0rd!zb into apply-confirm-input",
      "Click apply-next",
      "Check apply-review-summary (see expected)",
      "Check apply-terms-checkbox",
      "Click apply-submit",
      "Check apply-decision-approved (see expected)",
      "Click apply-decision-continue"
    ],
    "expected": [
      { "testId": "apply-step-2", "assert": "toBeVisible" },
      { "testId": "apply-step-3", "assert": "toBeVisible" },
      { "testId": "apply-review-summary", "assert": "toContainText", "value": "Checking + Savings" },
      { "testId": "apply-review-summary", "assert": "toContainText", "value": "•••-••-6789" },
      { "testId": "apply-decision-approved", "assert": "toContainText", "value": "Welcome to ZincBank, Nora" },
      { "testId": null, "assert": "toHaveURL", "value": "/dashboard" },
      { "testId": "dashboard-welcome", "assert": "toHaveText", "value": "Welcome, Nora" }
    ],
    "testIds": ["apply-account-savings-toggle", "apply-next", "apply-firstname-input", "apply-lastname-input", "apply-email-input", "apply-step-2", "apply-ssn-input", "apply-employment-select", "apply-step-3", "apply-addressline-input", "apply-city-input", "apply-state-select", "apply-zip-input", "apply-password-input", "apply-confirm-input", "apply-review-summary", "apply-terms-checkbox", "apply-submit", "apply-decision-approved", "apply-decision-continue", "dashboard-welcome"]
  },
