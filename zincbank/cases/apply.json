    ],
    "expected": [
      { "testId": "apply-step-1", "assert": "toContainText", "value": "First name is required" },
      { "testId": "apply-progress", "assert": "toHaveText", "value": "Step 2 of 6 · About you" }
    ],
    "testIds": ["apply-next", "apply-step-1", "apply-progress"]
  },
  {
    "id": "ZB-APPLY-04",
    "area": "apply",
    "title": "An invalid email does not advance and says \"Enter a valid email address\"",
    "given": [
      "A visitor who is NOT signed in (no fixture needed)"
    ],
    "steps": [
      "Open /apply",
      "Click apply-next (moves to About you)",
      "Type Nora into apply-firstname-input",
      "Type Quill into apply-lastname-input",
      "Type nora@ into apply-email-input",
      "Click apply-next"
    ],
    "expected": [
      { "testId": "apply-step-1", "assert": "toContainText", "value": "Enter a valid email address" },
      { "testId": "apply-step-2", "assert": "toHaveCount", "value": 0 }
    ],
    "testIds": ["apply-next", "apply-firstname-input", "apply-lastname-input", "apply-email-input", "apply-step-1", "apply-step-2"]
  },
  {
    "id": "ZB-APPLY-05",
    "area": "apply",
    "title": "Back from step 3 keeps what was typed on step 2",
    "given": [
      "A visitor who is NOT signed in (no fixture needed)",
      "A brand-new email nobody has registered: call the helper uniqueEmail('apply') imported from '../fixtures'. Do NOT use newCustomer here: it registers its email, and the application would then be refused"
    ],
    "steps": [
      "Open /apply",
      "Click apply-next (moves to About you)",
      "Type Nora into apply-firstname-input",
      "Type Quill into apply-lastname-input",
      "Type the unique applicant email into apply-email-input",
      "Click apply-next",
      "Wait until apply-step-2 is visible",
      "Click apply-back"
    ],
    "expected": [
      { "testId": "apply-step-2", "assert": "toBeVisible" },
      { "testId": "apply-step-1", "assert": "toBeVisible" },
      { "testId": "apply-firstname-input", "assert": "toHaveValue", "value": "Nora" }
    ],
    "testIds": ["apply-next", "apply-firstname-input", "apply-lastname-input", "apply-email-input", "apply-step-2", "apply-back", "apply-step-1"]
  },
