  {
    "id": "ZB-APPLY-03",
    "area": "apply",
    "title": "An empty About-you step does not advance and says \"First name is required\"",
    "given": [
      "A visitor who is NOT signed in (no fixture needed)"
    ],
    "steps": [
      "Open /apply",
      "Click apply-next (moves to About you)",
