  {
    "id": "ZB-CARD-06",
    "area": "cards",
    "title": "Paying $5.00 on a $50.00 card balance leaves $45.00 owed and $9,955.00 available",
    "given": [
      "A new signed-in customer (fixture: customer)",
      "$10.00 in the customer's checking (fixture: fund(customer, 1_000))"
    ],
    "steps": [
      "Precondition via API (apiPost): POST /api/credit/apply with { annualIncomeCents: 10000000, employmentStatus: 'employed', monthlyHousingCents: 100000, monthlyDebtCents: 0 }",
      "Precondition via API (apiPost): POST /api/credit/charge with { amountCents: 5000 }",
      "Open /cards with open(page, '/cards')",
      "Wait for cards-card-balance to read $50.00",
      "In cards-pay-from-select choose the customer's checking account (option value: customer.checkingId)",
      "Type 5.00 into cards-pay-amount-input",
      "Click cards-pay-submit"
    ],
    "expected": [
      {
        "testId": "cards-card-balance",
        "assert": "toHaveText",
        "value": "$50.00"
      },
      {
        "testId": "cards-pay-result",
        "assert": "toHaveText",
        "value": "Payment posted to your card."
      },
      {
        "testId": "cards-card-balance",
        "assert": "toHaveText",
        "value": "$45.00"
      },
      {
        "testId": "cards-card-available",
        "assert": "toHaveText",
        "value": "$9,955.00"
      }
    ],
    "testIds": [
      "cards-card-available",
      "cards-card-balance",
      "cards-pay-amount-input",
      "cards-pay-from-select",
      "cards-pay-result",
      "cards-pay-submit"
    ]
  }
]
