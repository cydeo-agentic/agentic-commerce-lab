  {
    "id": "ZB-CARD-02",
    "area": "cards",
    "title": "$100,000 income, employed, low debt is approved at Tier 1: $10,000.00 limit, 17.99%",
    "given": [
      "A new signed-in customer with no credit card (fixture: customer)"
    ],
    "steps": [
      "Check the customer's email contains zbtest- (safety check that this is a test customer)",
      "Open /cards with open(page, '/cards')",
      "Type 100000 into cards-apply-income-input",
      "In cards-apply-employment-select choose the option with value employed",
      "Type 1000 into cards-apply-housing-input",
      "Type 0 into cards-apply-debt-input",
      "Click cards-apply-submit"
    ],
    "expected": [
      {
        "testId": null,
        "assert": "toContain",
        "value": "zbtest-",
        "subject": "customer.email"
      },
      {
        "testId": "apply-decision-approved",
        "assert": "toBeVisible"
      },
      {
        "testId": "cards-card-limit",
        "assert": "toHaveText",
        "value": "$10,000.00"
      },
      {
        "testId": "cards-card-available",
        "assert": "toHaveText",
        "value": "$10,000.00"
      },
      {
        "testId": "cards-card-balance",
        "assert": "toHaveText",
        "value": "$0.00"
      },
      {
        "testId": "cards-card-apr",
        "assert": "toHaveText",
        "value": "17.99%"
      }
    ],
    "testIds": [
      "apply-decision-approved",
      "cards-apply-debt-input",
      "cards-apply-employment-select",
      "cards-apply-housing-input",
      "cards-apply-income-input",
      "cards-apply-submit",
      "cards-card-apr",
      "cards-card-available",
      "cards-card-balance",
      "cards-card-limit"
    ]
  },
