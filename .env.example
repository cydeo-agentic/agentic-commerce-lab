# npm run dev writes this file for you on the first run (your own Stripe sandbox). Never commit .env.
# STRIPE_SECRET_KEY=        sandbox test key (rkcs_test_/sk_test_/rk_test_). Live keys are refused.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_ACCOUNT_ID=
# STRIPE_CLAIM_URL=         open it to keep the sandbox and get the Stripe dashboard (npm run claim)
# STRIPE_SANDBOX_EXPIRES=   unclaimed sandboxes expire after 7 days; npm run dev makes a new one
# STRIPE_WEBHOOK_SECRET=    from `stripe listen --print-secret`
#
# STORE_PAYMENTS=offline    use the local payment simulator (only when your instructor says so)
